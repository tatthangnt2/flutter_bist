{
  "schema": 4,
  "type": "suite",
  "id": "demo",
  "name": "Demo app",
  "units": [
    {
      "type": "suite",
      "id": "login",
      "name": "Login",
      "pre": [
        {
          "cmd": "nav",
          "path": "/login"
        }
      ],
      "units": [
        {
          "type": "case",
          "id": "login.empty",
          "name": "Missing fields",
          "steps": [
            {
              "cmd": "input",
              "value": "",
              "text": "Username"
            },
            {
              "cmd": "input",
              "value": "",
              "text": "Password"
            },
            {
              "cmd": "tap",
              "text": "SIGN IN",
              "type": "button"
            },
            {
              "cmd": "expect",
              "text": "Please enter your username and password."
            }
          ]
        },
        {
          "type": "case",
          "id": "login.wrong",
          "name": "Wrong password",
          "steps": [
            {
              "cmd": "input",
              "value": "alice",
              "text": "Username"
            },
            {
              "cmd": "input",
              "value": "x",
              "text": "Password"
            },
            {
              "cmd": "tap",
              "text": "SIGN IN",
              "type": "button"
            },
            {
              "cmd": "expect",
              "text": "Wrong password."
            }
          ]
        }
      ]
    },
    {
      "type": "sequence",
      "id": "orders",
      "name": "Orders",
      "units": [
        {
          "type": "case",
          "id": "orders.open",
          "name": "Sign in",
          "steps": [
            {
              "cmd": "nav",
              "path": "/login"
            },
            {
              "cmd": "input",
              "value": "alice",
              "text": "Username"
            },
            {
              "cmd": "input",
              "value": "secret",
              "text": "Password"
            },
            {
              "cmd": "tap",
              "text": "SIGN IN",
              "type": "button"
            },
            {
              "cmd": "expect",
              "route": "/orders",
              "timeout": 3000
            }
          ]
        },
        {
          "type": "case",
          "id": "orders.add",
          "name": "Add an order",
          "steps": [
            {
              "cmd": "expect",
              "text": "^Order \\d+$",
              "match": "regex",
              "count": 2
            },
            {
              "cmd": "tap",
              "icon": "add"
            },
            {
              "cmd": "expect",
              "text": "Order 3"
            },
            {
              "cmd": "notExpect",
              "text": "Order 4"
            }
          ]
        }
      ]
    }
  ]
}
